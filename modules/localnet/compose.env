## Variables for substitution in docker-compose files
## Container specific variables are placed in the respective container's --env-file

IMAGE_REPO=${IMAGE_REPO:-ghcr.io/digital-asset/decentralized-canton-sync/docker/} # Publicly released images


POSTGRES_VERSION=${POSTGRES_VERSION:-18.7-trixie@sha256:2ea8630df176ad090ec92136dee850397c5af8781e4bcf2e4162593691c61bbc}
NGINX_VERSION=${NGINX_VERSION:-1.31.9-alpine-slim@sha256:75e85a09b0f25bd46d49a9fd85589ffa70b0459c8ed5ee0dc6596fd642e1f829}

DOCKER_NETWORK=${DOCKER_NETWORK:-localnet}

LOCALNET_DIR=${LOCALNET_DIR:-.}
LOCALNET_ENV_DIR=${LOCALNET_ENV_DIR:-$LOCALNET_DIR/env}

SV_PROFILE=${SV_PROFILE:-on}
APP_PROVIDER_PROFILE=${APP_PROVIDER_PROFILE:-on}
APP_USER_PROFILE=${APP_USER_PROFILE:-on}

APP_PROVIDER_AUTH_ENV=${LOCALNET_ENV_DIR}/app-provider-auth-${APP_PROVIDER_PROFILE}.env
APP_USER_AUTH_ENV=${LOCALNET_ENV_DIR}/app-user-auth-${APP_USER_PROFILE}.env
SV_AUTH_ENV=${LOCALNET_ENV_DIR}/sv-auth-${SV_PROFILE}.env


PARTY_HINT=${PARTY_HINT:-$DOCKER_NETWORK-localparty-1}

UTILITIES_IMAGE_REPO=${UTILITIES_IMAGE_REPO:-europe-docker.pkg.dev/da-images/public/docker}
UTILITIES_IMAGE_VERSION=${UTILITIES_IMAGE_VERSION:-0.15.4}
UTILITIES_BACKEND_VERSION=${UTILITIES_BACKEND_VERSION:-0.14.15}

## Participant Query Store (required by hosted-backend >= 0.13)
PQS_IMAGE_REPO=${PQS_IMAGE_REPO:-europe-docker.pkg.dev/da-images/public/docker}
PQS_VERSION=${PQS_VERSION:-3.7.3}
# Static HS256 JWT (secret "unsafe", no expiry) for sub=ledger-api-user, aud=https://canton.network.global.
# Matches the unsafe-jwt-hmac-256 auth-services in conf/canton/*/app-auth.conf. Localnet only.
PQS_LEDGER_API_TOKEN=${PQS_LEDGER_API_TOKEN:-eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJsZWRnZXItYXBpLXVzZXIiLCJhdWQiOiJodHRwczovL2NhbnRvbi5uZXR3b3JrLmdsb2JhbCJ9.G9aLv-IF5X0WmIkbR10f48i-7it5LlgwpJEZ4Ce2Y-E}
